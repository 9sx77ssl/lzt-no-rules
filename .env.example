# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=wss://lztws.d9v.uk/ws
ROOM_TITLE=No Rules
LOG_LEVEL=info

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=/opt/no-rules/data/no-rules.db

# ── Extension access ─────────────────────────────────────────────────────────
# Shared value embedded into the userscript. It is a first-line abuse filter,
# not an authentication mechanism: the real identity check is the forum token.
# Generate: openssl rand -base64 48 | tr -d '\n=' | tr '+/' '-_'
ACCESS_KEY=replace-with-at-least-16-random-characters

# Comma-separated forum user IDs. Empty = every forum account may connect.
ALLOWED_USER_IDS=
# Users allowed to delete any message (moderation). Empty = authors only.
ADMIN_USER_IDS=

# ── Network / Cloudflare ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://lolz.team,https://lolz.live,https://lolz.guru,https://zelenka.guru
TRUST_PROXY=1
ALLOW_MISSING_ORIGIN=1

# Optional direct TLS (not needed behind nginx). Leave empty to run plain HTTP.
TLS_KEY_PATH=
TLS_CERT_PATH=

# ── Forum identity verification ──────────────────────────────────────────────
LOLZ_API_BASE=https://api.lolz.team
AUTH_TIMEOUT_MS=10000
AUTH_CACHE_TTL_MS=300000
SESSION_TTL_DAYS=30
MAX_SESSIONS_PER_USER=20

# ── Message limits ───────────────────────────────────────────────────────────
MAX_MESSAGE_HTML=12000
MAX_MESSAGE_TEXT=2000
MAX_MESSAGE_BYTES=65536
MAX_IMAGES_PER_MESSAGE=4
MAX_LINKS_PER_MESSAGE=5
MAX_MENTIONS_PER_MESSAGE=8
MAX_NEWLINES_PER_MESSAGE=30
ALLOW_EXTERNAL_IMAGES=0
HISTORY_PAGE_SIZE=50
MAX_HISTORY_PAGE_SIZE=100

# ── Rate limits (burst tokens, refill seconds per token) ─────────────────────
RATE_AUTH_BURST=12
RATE_AUTH_REFILL=60
RATE_MESSAGE_BURST=8
RATE_MESSAGE_REFILL=1.5
RATE_TYPING_BURST=1
RATE_TYPING_REFILL=3
RATE_HISTORY_BURST=20
RATE_HISTORY_REFILL=3
RATE_EDIT_BURST=6
RATE_EDIT_REFILL=2
RATE_DELETE_BURST=6
RATE_DELETE_REFILL=2
